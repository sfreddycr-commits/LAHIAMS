# LAHIAM'S — variables de entorno (Wiazart Core stack)
# Este archivo es .env.example; crea un .env real con estos valores y permisos 600.
# NUNCA commitear el .env real (está en .gitignore).

APP_ENV="production"

# Credenciales de login (JWT sub=1 = usuario seed de sp_profile_get)
APP_USER="admin"
APP_PASS="cambia-esta-clave"

# Secreto para firmar el JWT HS256 (usar un string largo y aleatorio)
JWT_SECRET="cambia-este-secreto-jwt-muy-largo-y-aleatorio"

# Rate limiting por IP (peticiones por ventana en segundos)
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW="60"

# Credenciales de MySQL 8
DB_HOST="127.0.0.1"
DB_NAME="lahiams"
DB_USER="lahiams"
DB_PASS="cambia-clave-bd"

# IA (opcional). Si falta, /api/ai responde 503 AI_NOT_CONFIGURED honestamente.
GEMINI_API_KEY=""
